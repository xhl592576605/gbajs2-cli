{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "worker": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn",
    "no-redeclare": "warn",
    "no-empty": "warn",
    "no-extra-semi": "warn",
    "no-undef": "error",
    "no-fallthrough": "warn",
    "no-prototype-builtins": "warn",
    "no-mixed-spaces-and-tabs": "off"
  }
}